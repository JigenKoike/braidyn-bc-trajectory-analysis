# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Notebooks: scratch / personal exploration (committable notebooks live in notebooks/)
notebooks/scratch/
# The analyses the co-authors asked for before submission. Kept out of git
# until it is settled which of them the paper keeps; whatever is kept moves
# into notebooks/paper/ and is committed there, named for its figure.
# ("revision" is left free for the peer-review round.)
notebooks/presubmission/
# Working notes in Japanese for whoever picks this up next; not published.
notebooks/HANDOFF.md

# Data & output (large / reproducible)
# data/* rather than data/, so that one subdirectory can be let back in:
# git will not look inside an excluded directory, and a negation under one
# never matches.
data/*
output/
*.nwb
*.h5
*.hdf5

# The package the figures read. Small, and it belongs beside the code that
# reads it; scripts/build_paper_dataset.py writes it. The second line is
# needed as well: re-including the directory does not undo the *.h5 rule
# above for a file inside it.
!data/paper/
!data/paper/**

# Editor / IDE
.vscode/*
!.vscode/settings.json
.idea/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Claude Code local session state
.claude/
